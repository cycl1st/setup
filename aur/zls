pkgname=zls-git
pkgver=0.17.0.r31.gb3e65123
pkgrel=1
pkgdesc="ZLS is a non-official implementation of the Language Server Protocol for Zig in Zig."
arch=('x86_64')
url="https://github.com/zigtools/zls"
license=('MIT')
depends=('zig-git')
makedepends=('git')
provides=('zls')
conflicts=('zls')
options=()
install=
source=("${pkgname}::git+https://github.com/zigtools/zls#branch=master")
noextract=()
sha256sums=('SKIP')


pkgver() {
	cd "$srcdir/${pkgname}"
  git describe --long --tags --abbrev=8 | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
	cd "$srcdir/${pkgname}"
	zig build -Doptimize=ReleaseFast
}

package() {
    mkdir -p "$pkgdir/opt/zig-git/bin/"
	  cp "$srcdir/$pkgname/zig-out/bin/zls" "$pkgdir/opt/zig-git/bin/"
    install -d "$pkgdir/usr/bin"
    ln -s "/opt/zig-git/bin/zls" "$pkgdir/usr/bin/zls"
}
